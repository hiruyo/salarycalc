---
interface Props {
  /** 계산기 식별자 (저장 데이터 구분용, 바꾸면 기존 이력이 안 보임) */
  calc: string;
  /** CSV 파일 이름 등에 쓰는 이름 */
  title: string;
}
const { calc, title } = Astro.props;
---

<section class="history" data-history data-calc={calc} data-title={title}>
  <div class="history-head">
    <h2>내 계산 기록</h2>
    <div class="history-actions">
      <button type="button" data-act="save">결과 저장</button>
      <button type="button" class="ghost" data-act="csv">CSV 내보내기</button>
    </div>
  </div>
  <p class="hint" data-msg aria-live="polite">로그인 없이 이 브라우저에만 저장돼요. 다른 기기에서는 보이지 않아요.</p>
  <ul class="history-list" data-list></ul>
</section>

<script>
  import { mountHistory } from '../lib/historyUi';
  document.querySelectorAll<HTMLElement>('[data-history]').forEach((el) => mountHistory(el));
</script>
