---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { RATES } from '../rates/2026';
import { GUIDES } from '../guides';
import { SITE } from '../site';
import { CALC_GROUPS } from '../calculators';
import { calcNetPay } from '../lib/netpay';

// 첫 화면 미리 계산 (스크립트가 실행되기 전에도 숫자가 보이도록)
const initial = calcNetPay({ annualSalary: 40_000_000, nonTaxableMonthly: 200_000, familyCount: 1 });
const won = (n: number) => `${n.toLocaleString('ko-KR')}원`;
---

<Base
  title={`${SITE.name} - 연봉 실수령액·연차·퇴직금·실업급여 생활 계산기 (${RATES.year}년)`}
  description={`${RATES.year}년 기준을 반영한 생활 계산기 모음. 연봉 실수령액, 연말정산 환급, 주휴수당, 퇴직금, 연차, 실업급여, 프리랜서 3.3%, 전월세 전환, 날짜 계산을 회원가입 없이 바로 하고 결과를 저장하세요.`}
>
  <section class="hero wide">
    <div class="hero-copy">
      <h1>숫자를 넣는 순간<br />계산이 끝나요</h1>
      <p class="lead">
        월급, 세금, 퇴사, 집, 날짜까지. {RATES.year}년 기준으로 바로 계산하고 결과는 저장해 둘 수 있어요.
        입력한 값은 이 기기 밖으로 나가지 않아요.
      </p>
    </div>

    <form class="receipt quick" id="quick" onsubmit="return false;" aria-label="연봉 실수령액 빠른 계산">
      <label for="quick-salary">연봉 (만원)</label>
      <input id="quick-salary" type="number" inputmode="numeric" min="0" step="100" value="4000" />
      <div class="result-main">
        <div class="label">월 예상 실수령액</div>
        <div class="big" id="quick-net">{won(initial.netMonthly)}</div>
      </div>
      <table>
        <tbody>
          <tr><th>4대보험</th><td id="quick-ins">{won(initial.insuranceTotal)}</td></tr>
          <tr><th>소득세·지방소득세</th><td id="quick-tax">{won(initial.taxTotal)}</td></tr>
        </tbody>
      </table>
      <p class="hint">식대 20만원 비과세, 1인 가구 기준이에요.</p>
      <a class="quick-more" id="quick-more" href="/salary#salary=4000">공제 내역 자세히 보기</a>
    </form>
  </section>

  <section class="calc-index my-calcs wide" id="my-calcs" hidden aria-label="내 계산기">
    <div class="calc-group">
      <h2>내 계산기</h2>
      <ul></ul>
    </div>
  </section>

  <section class="calc-index wide" aria-label="계산기 목록">
    {CALC_GROUPS.map((g) => (
      <div class="calc-group">
        <h2>{g.name}</h2>
        <ul>
          {g.items.map((c) => (
            <li>
              <a href={c.href}>
                <span class="calc-icon"><Icon name={c.icon} /></span>
                <span class="calc-text">
                  <strong>{c.name}</strong>
                  <span>{c.desc}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <h2>급여·세금 가이드</h2>
  <ul class="links">
    {GUIDES.slice(0, 5).map((g) => (
      <li>
        <a href={`/guide/${g.slug}`}>
          <strong>{g.title}</strong>
          <span>{g.description}</span>
        </a>
      </li>
    ))}
  </ul>
  <p><a href="/guide">가이드 전체 보기</a></p>

  <script>
    import { calcNetPay } from '../lib/netpay';

    const input = document.getElementById('quick-salary') as HTMLInputElement;
    const set = (id: string, text: string) => {
      document.getElementById(id)!.textContent = text;
    };
    const won = (n: number) => `${n.toLocaleString('ko-KR')}원`;

    function render() {
      const man = Number(input.value) || 0;
      const r = calcNetPay({ annualSalary: man * 10_000, nonTaxableMonthly: 200_000, familyCount: 1 });
      set('quick-net', man > 0 ? won(r.netMonthly) : '-');
      set('quick-ins', man > 0 ? won(r.insuranceTotal) : '-');
      set('quick-tax', man > 0 ? won(r.taxTotal) : '-');
      (document.getElementById('quick-more') as HTMLAnchorElement).href = `/salary#salary=${encodeURIComponent(String(man || 4000))}`;
    }
    input.addEventListener('input', render);
    render();
  </script>
</Base>

<style is:global>
  .hero { display: grid; gap: 24px; align-items: center; margin: 8px 0 44px; }
  .hero h1 { font-size: 2.45rem; line-height: 1.22; letter-spacing: -0.035em; margin-bottom: 14px; }
  .hero .lead { max-width: 30em; margin: 0; }
  @media (min-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr) 400px; gap: 48px; margin: 24px 0 56px; }
    .hero h1 { font-size: 3rem; }
  }
  @media (max-width: 560px) { .hero h1 { font-size: 2rem; } }

  .quick label { margin-top: 0; }
  .quick input { margin-bottom: 18px; font-size: 1.15rem; }
  .quick-more { display: inline-block; margin-top: 10px; font-weight: 500; font-size: 0.95rem; }

  .calc-index { display: grid; gap: 8px 40px; }
  .my-calcs { margin-bottom: 28px; }
  .my-calcs[hidden] { display: none; }
  .my-calcs .calc-group { grid-column: 1 / -1; }
  .my-calcs ul { display: grid; gap: 0 40px; }
  @media (min-width: 900px) { .my-calcs ul { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .calc-index { grid-template-columns: repeat(3, 1fr); } }
  .calc-group h2 { font-size: 0.95rem; color: var(--muted); font-weight: 500; margin: 12px 0 4px; }
  .calc-group ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .calc-group li { margin: 0; border-bottom: 1px solid var(--line); }
  .calc-group a { display: flex; align-items: center; gap: 14px; padding: 14px 4px; text-decoration: none; color: var(--ink); }
  .calc-group a:hover strong { color: var(--blue); }
  .calc-icon {
    display: grid; place-items: center; flex-shrink: 0; width: 42px; height: 42px;
    border-radius: 10px; background: var(--blue-soft); color: var(--blue);
  }
  .calc-text { display: flex; flex-direction: column; min-width: 0; }
  .calc-text strong { font-weight: 700; font-size: 1.02rem; }
  .calc-text span { color: var(--muted); font-size: 0.88rem; }
</style>
