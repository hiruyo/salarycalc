---
import { SITE } from '../site';

interface Props {
  /** 계산기 식별자 (GA 이벤트용) */
  calc: string;
  /** 공유 링크 버튼 표시 여부 (입력값을 링크로 옮길 수 없는 계산기는 false) */
  share?: boolean;
}
const { calc, share = true } = Astro.props;
---

<div class="result-actions" data-result-actions data-calc={calc} data-email={SITE.contactEmail}>
  <div class="ra-buttons">
    {share && (
      <button type="button" data-act="share">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1 0l3-3a5 5 0 0 0-7.1-7.1l-1.1 1.1" /><path d="M14 11a5 5 0 0 0-7.1 0l-3 3a5 5 0 0 0 7.1 7.1l1.1-1.1" /></svg>
        링크 공유
      </button>
    )}
    <button type="button" data-act="image">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="M21 15l-5-5L5 21" /></svg>
      이미지 저장
    </button>
  </div>
  <p class="ra-msg" data-msg aria-live="polite"></p>
  <button type="button" class="ra-report" data-act="report">계산이 이상한가요? 알려주세요</button>
</div>

<script>
  import { mountResultActions } from '../lib/resultActions';
  document.querySelectorAll<HTMLElement>('[data-result-actions]').forEach((el) => mountResultActions(el));
</script>
