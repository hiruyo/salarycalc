---
import Base from '../layouts/Base.astro';
import SaveHistory from '../components/SaveHistory.astro';
import { YEAR_END as Y } from '../rates/yearEnd2026';
import { GUIDES } from '../guides';

const relatedGuides = GUIDES.filter((g) => ['year-end-tax-guide', 'withholding-tax', 'salary-table-2026'].includes(g.slug));
const man = (n: number) => `${(n / 10_000).toLocaleString('ko-KR')}만원`;
---

<Base
  title={`${Y.year}년 귀속 연말정산 환급 계산기 (13월의 월급 미리 계산)`}
  description={`${Y.year}년 귀속 연말정산(${Y.year + 1}년 1~2월) 환급액을 미리 계산해요. 신용카드 자녀별 한도 상향, 자녀세액공제 대상(2006~2016년생), 연금저축·IRP, 월세, 의료비, 교육비까지 반영합니다.`}
>
  <h1>{Y.year}년 귀속 연말정산 환급 계산기</h1>
  <p class="lead">
    올해 급여와 지출을 넣으면 {Y.year + 1}년 초 연말정산에서 돌려받을(또는 더 낼) 금액을 미리 계산해요. 금액은 모두 <strong>만원</strong> 단위예요.
  </p>

  <div class="calc-layout">
    <form id="calc-form" class="card" onsubmit="return false;">
      <h2 class="form-h">기본 정보</h2>
      <label for="salary">올해 총급여 (만원)</label>
      <input id="salary" type="number" inputmode="decimal" min="0" step="100" value="5000" />
      <div class="hint">비과세(식대 등)를 뺀 연간 급여예요. 성과급 포함. 모르면 연봉에서 연 식대 240만원을 빼세요.</div>

      <label for="dependents">기본공제 인원 (본인 포함)</label>
      <input id="dependents" type="number" inputmode="numeric" min="1" step="1" value="1" />
      <div class="hint">소득이 적은 배우자·자녀·부모님 등 부양가족을 더해요 (연 소득금액 100만원 이하 등 요건).</div>

      <label for="seniors">그중 70세 이상</label>
      <input id="seniors" type="number" inputmode="numeric" min="0" step="1" value="0" />
      <label for="disabledCount">그중 장애인</label>
      <input id="disabledCount" type="number" inputmode="numeric" min="0" step="1" value="0" />

      <label for="kids20">기본공제 받는 자녀 수 (20세 이하, 장애인은 나이 무관)</label>
      <input id="kids20" type="number" inputmode="numeric" min="0" step="1" value="0" />
      <label for="kids9">그중 2006~2016년생 자녀 수 (장애인은 나이 무관)</label>
      <input id="kids9" type="number" inputmode="numeric" min="0" step="1" value="0" />
      <div class="hint">{Y.year}년 귀속 자녀세액공제는 9세 이상이 대상이지만, 2017년생은 부칙에 따라 제외돼서 실제로는 2006~2016년생이에요.</div>

      <label for="birth">올해 출생·입양한 자녀</label>
      <select id="birth">
        <option value="0" selected>없음</option>
        <option value="1">첫째</option>
        <option value="2">둘째</option>
        <option value="3">셋째 이상</option>
      </select>
      <label class="check"><input id="married" type="checkbox" /> 올해 혼인신고 (결혼세액공제, 생애 1회)</label>

      <details open>
        <summary>카드·현금 사용액 (연간, 만원)</summary>
        <label for="credit">신용카드</label>
        <input id="credit" type="number" inputmode="decimal" min="0" step="10" value="1500" />
        <label for="debit">체크카드·현금영수증</label>
        <input id="debit" type="number" inputmode="decimal" min="0" step="10" value="500" />
        <label for="culture">도서·공연·영화·체육시설 등 문화체육</label>
        <input id="culture" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <div class="hint">총급여 7천만원 이하만 30%로 따로 공제돼요. 7천만원 초과라면 이 칸 대신 결제한 수단(신용카드·체크카드) 칸에 더해 넣으세요.</div>
        <label for="market">전통시장</label>
        <input id="market" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <label for="transit">대중교통</label>
        <input id="transit" type="number" inputmode="decimal" min="0" step="10" value="60" />
        <div class="hint">아직 연말이 아니면 지금까지 쓴 금액에 남은 달 예상치를 더해 넣으세요.</div>
      </details>

      <details>
        <summary>연금·보험·의료·교육·기부·월세 (연간, 만원)</summary>
        <label for="pensionSavings">연금저축 납입액</label>
        <input id="pensionSavings" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <label for="irp">IRP 납입액 (본인 납입분)</label>
        <input id="irp" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <label for="lifeIns">보장성 보험료</label>
        <input id="lifeIns" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <label for="medSelf">의료비: 본인·65세 이상·장애인·6세 이하 자녀</label>
        <input id="medSelf" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <label for="medOther">의료비: 그 외 부양가족</label>
        <input id="medOther" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <label for="edu">교육비 (1인당 한도 내 금액)</label>
        <input id="edu" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <div class="hint">본인은 한도 없음, 유치원~고등학생 1인당 300만원, 대학생 900만원까지 넣으세요.</div>
        <label for="donation">기부금 (일반 기부금)</label>
        <input id="donation" type="number" inputmode="decimal" min="0" step="1" value="0" />
        <label for="rent">월세 (연간 합계)</label>
        <input id="rent" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <div class="hint">무주택 세대주(요건 충족 시 세대원), 국민주택규모 또는 기준시가 4억원 이하, 전입신고한 주택이어야 해요.</div>
        <label for="housing">주택청약 납입액</label>
        <input id="housing" type="number" inputmode="decimal" min="0" step="10" value="0" />
        <div class="hint">총급여 7천만원 이하 무주택 세대주만 공제돼요.</div>
      </details>

      <details>
        <summary>이미 낸 세금·보험료 (선택, 비우면 자동 추정)</summary>
        <label for="prepaid">올해 원천징수된 소득세 합계 (만원)</label>
        <input id="prepaid" type="number" inputmode="decimal" min="0" step="1" placeholder="비우면 간이세액표로 추정" />
        <div class="hint">급여명세서 '소득세' 칸을 모두 더한 값이에요(지방소득세 제외). 정확할수록 결과가 정확해져요.</div>
        <label for="pensionPaid">국민연금 납부액 (만원)</label>
        <input id="pensionPaid" type="number" inputmode="decimal" min="0" step="1" placeholder="비우면 총급여로 추정" />
        <label for="insPaid">건강·장기요양·고용보험료 합계 (만원)</label>
        <input id="insPaid" type="number" inputmode="decimal" min="0" step="1" placeholder="비우면 총급여로 추정" />
      </details>
    </form>

    <div class="receipt" data-history-results>
      <div class="result-main">
        <div class="label" id="out-main-label">예상 환급액</div>
        <div class="big" id="out-main">-</div>
      </div>
      <table>
        <tbody id="out-rows"></tbody>
      </table>
      <p class="hint" id="out-tip"></p>
    </div>
    <SaveHistory calc="year-end-tax" title="연말정산" />
  </div>


  <p class="notice">
    근로소득만 있는 직장인 기준의 예상치예요. 부녀자·한부모 공제, 주택자금, 난임 의료비, 고향사랑·정치자금 기부금 등은 반영하지 않았어요.
    정확한 금액은 {Y.year + 1}년 1월 국세청 홈택스 '연말정산 간소화 서비스'와 '예상세액 계산'으로 확인하세요.
  </p>

  <h2>{Y.year}년 귀속 연말정산, 무엇이 달라졌나</h2>
  <ul>
    <li><strong>신용카드 공제 한도 자녀별 상향</strong>: 총급여 7천만원 이하는 기본한도 {man(Y.card.baseLimitLow[0])}에 자녀 1명당 50만원(최대 {man(Y.card.baseLimitLow[2])}), 7천만원 초과는 {man(Y.card.baseLimitHigh[0])}에 자녀 1명당 25만원(최대 {man(Y.card.baseLimitHigh[2])})이에요.</li>
    <li><strong>자녀세액공제 9세 이상</strong>: 대상 나이가 8세에서 9세 이상으로 바뀌었어요. 다만 2017년생은 부칙에 따라 제외돼서 실제 대상은 2006~2016년생이에요. 금액은 1명 25만원, 2명 55만원, 3명부터 1명당 40만원 추가로 같아요.</li>
    <li><strong>초등 저학년 예체능 학원비</strong>: 9세 미만 또는 초등 1~2학년 자녀의 예체능 학원·체육시설 수강료가 교육비 공제 대상에 들어갔어요.</li>
    <li><strong>결혼세액공제</strong>: 2024~2026년에 혼인신고하면 생애 한 번 50만원을 공제받아요.</li>
  </ul>

  <h2>계산 방법</h2>
  <ol>
    <li>총급여에서 근로소득공제를 빼 근로소득금액을 구해요.</li>
    <li>인적공제(1인당 150만원), 국민연금, 건강·고용보험료, 신용카드 등 소득공제를 빼면 과세표준이에요.</li>
    <li>과세표준에 세율(6~45%)을 곱해 산출세액을 구해요.</li>
    <li>근로소득·자녀·연금계좌·보험료·의료비·교육비·기부금·월세 세액공제를 빼면 결정세액이에요. 특별공제가 적으면 표준세액공제(13만원)가 더 유리할 수 있어 둘 다 계산해 유리한 쪽을 써요.</li>
    <li>1년 동안 월급에서 미리 뗀 세금(기납부세액)이 결정세액보다 많으면 차액을 돌려받고, 적으면 더 내요.</li>
  </ol>

  <h2>관련 가이드</h2>
  <ul class="links">
    {relatedGuides.map((g) => (
      <li>
        <a href={`/guide/${g.slug}`}>
          <strong>{g.title}</strong>
          <span>{g.description}</span>
        </a>
      </li>
    ))}
  </ul>

  <script>
    import { calcYearEnd } from '../lib/yearEndTax';

    const MAN = 10_000;
    const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
    const num = (id: string) => (Number($(id).value) || 0) * MAN;
    const intv = (id: string) => Math.floor(Number($(id).value) || 0);
    const opt = (id: string) => ($(id).value.trim() === '' ? undefined : (Number($(id).value) || 0) * MAN);
    const won = (n: number) => `${Math.round(n).toLocaleString('ko-KR')}원`;

    function rows(items: [string, string][]) {
      const tbody = $<HTMLElement>('out-rows');
      tbody.innerHTML = '';
      for (const [k, v] of items) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        const td = document.createElement('td');
        th.textContent = k;
        td.textContent = v;
        tr.append(th, td);
        tbody.append(tr);
      }
    }

    function render() {
      const r = calcYearEnd({
        salary: num('salary'),
        dependents: Math.max(1, intv('dependents')),
        seniors70: intv('seniors'),
        disabled: intv('disabledCount'),
        childrenUnder20: intv('kids20'),
        children9plus: intv('kids9'),
        birthOrder: Number($<HTMLSelectElement>('birth').value) as 0 | 1 | 2 | 3,
        married: $('married').checked,
        creditCard: num('credit'),
        debitCash: num('debit'),
        culture: num('culture'),
        market: num('market'),
        transit: num('transit'),
        pensionSavings: num('pensionSavings'),
        irp: num('irp'),
        lifeInsurance: num('lifeIns'),
        medicalSelf: num('medSelf'),
        medicalOther: num('medOther'),
        education: num('edu'),
        donation: num('donation'),
        rent: num('rent'),
        housingSubscription: num('housing'),
        prepaidTax: opt('prepaid'),
        pensionPaid: opt('pensionPaid'),
        insurancePaid: opt('insPaid'),
      });

      const label = $<HTMLElement>('out-main-label');
      const main = $<HTMLElement>('out-main');
      if (!r.valid) {
        label.textContent = '예상 환급액';
        main.textContent = '-';
        rows([['확인', '총급여를 입력해 주세요']]);
        $<HTMLElement>('out-tip').textContent = '';
        return;
      }

      label.textContent = r.refund >= 0 ? '예상 환급액 (소득세 + 지방소득세)' : '예상 추가 납부액 (소득세 + 지방소득세)';
      main.textContent = won(Math.abs(r.refund));

      const c = r.credits;
      const creditSum = c.earned + c.child + c.birth + c.marriage + c.pension + c.insurance + c.medical + c.education + c.donation + c.rent + c.standard;
      const detail: string[] = [];
      if (c.child) detail.push(`자녀 ${won(c.child)}`);
      if (c.birth) detail.push(`출산 ${won(c.birth)}`);
      if (c.marriage) detail.push(`결혼 ${won(c.marriage)}`);
      if (c.pension) detail.push(`연금계좌 ${won(c.pension)}`);
      if (c.insurance) detail.push(`보험료 ${won(c.insurance)}`);
      if (c.medical) detail.push(`의료비 ${won(c.medical)}`);
      if (c.education) detail.push(`교육비 ${won(c.education)}`);
      if (c.donation) detail.push(`기부금 ${won(c.donation)}`);
      if (c.rent) detail.push(`월세 ${won(c.rent)}`);
      if (c.standard) detail.push(`표준 ${won(c.standard)}`);

      rows([
        ['결정세액 (낼 세금)', won(r.decidedTax + r.decidedLocalTax)],
        ['기납부세액 (낸 세금)', `${won(r.prepaidTax + r.prepaidLocalTax)}${r.prepaidEstimated ? ' (추정)' : ''}`],
        ['과세표준', won(r.taxBase)],
        ['산출세액', won(r.calculatedTax)],
        ['카드 등 소득공제', won(r.card.deduction)],
        ['근로소득세액공제', won(c.earned)],
        ['기타 세액공제', detail.length ? detail.join(' · ') : '없음'],
        ['세액공제 합계', won(creditSum)],
        ['적용 방식', r.method === 'standard' ? '표준세액공제' : '항목별 특별공제'],
        [`국민연금${r.pensionEstimated ? ' (추정)' : ''}`, won(r.pensionPaid)],
        [`건강·고용보험${r.insuranceEstimated ? ' (추정)' : ''}`, won(r.insurancePaid)],
      ]);

      const tip = $<HTMLElement>('out-tip');
      const left = r.card.minSpend - r.card.total;
      if (left > 0) {
        tip.textContent = `카드 사용액이 총급여의 25%(${won(r.card.minSpend)})에 ${won(left)} 못 미쳐 카드 공제가 아직 없어요. 이 금액까지는 혜택이 많은 신용카드를 쓰고, 넘는 부분은 체크카드·현금영수증(30%)이 유리해요.`;
      } else if (r.card.base < r.card.baseLimit) {
        tip.textContent = `카드 공제 기본한도(${won(r.card.baseLimit)})까지 ${won(r.card.baseLimit - r.card.base)} 남았어요. 남은 기간에는 체크카드·현금영수증을 쓰면 공제가 더 빨리 늘어요.`;
      } else {
        tip.textContent = `카드 공제 기본한도(${won(r.card.baseLimit)})를 다 채웠어요. 전통시장·대중교통 사용분은 추가한도로 더 공제받을 수 있어요.`;
      }
      if (r.prepaidEstimated) tip.textContent += ' 기납부세액은 간이세액표로 추정한 값이라, 급여명세서의 실제 소득세 합계를 넣으면 더 정확해요.';
    }

    $<HTMLFormElement>('calc-form').addEventListener('input', render);
    $<HTMLFormElement>('calc-form').addEventListener('change', render);
    render();
  </script>
</Base>

