---
import { RATES } from '../rates/2026';
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
}
const { title, description, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#1f6feb" />
    {SITE.adsenseClient && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{SITE.name}</a>
        <nav>
          <a href="/salary">실수령액</a>
          <a href="/weekly-holiday-pay">주휴수당</a>
          <a href="/severance-pay">퇴직금</a>
          <a href="/unemployment-benefit">실업급여</a>
          <a href="/guide">가이드</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav class="footer-links" aria-label="사이트 정보">
          <a href="/about">소개</a>
          <a href="/guide">가이드</a>
          <a href="/privacy">개인정보처리방침</a>
          <a href="/terms">이용약관</a>
          <a href="/contact">문의</a>
        </nav>
        <p>
          기준 연도: {RATES.year}년. 계산 결과는 참고용 예상치이며 실제 급여·세액과 다를 수 있습니다.
          정확한 금액은 회사 급여명세서와 국세청·4대보험 공단 자료를 확인하세요.
        </p>
        <p>© {RATES.year} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f8fa;
    --card: #fff;
    --text: #1f2328;
    --muted: #656d76;
    --line: #d8dee4;
    --accent: #1f6feb;
    --accent-soft: #e8f0fe;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
  }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 16px; }
  .site-header { background: var(--card); border-bottom: 1px solid var(--line); }
  .site-header .wrap { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { font-weight: 800; color: var(--accent); text-decoration: none; font-size: 1.1rem; }
  .brand { flex-shrink: 0; margin-right: 8px; }
  nav { display: flex; min-width: 0; overflow-x: auto; white-space: nowrap; }
  label.check { display: flex; align-items: center; gap: 8px; font-weight: 500; }
  label.check input { width: 18px; height: 18px; }
  nav a { margin-left: 14px; color: var(--text); text-decoration: none; font-size: 0.95rem; }
  nav a:hover { color: var(--accent); }
  main { padding-top: 24px; padding-bottom: 48px; }
  h1 { font-size: 1.6rem; line-height: 1.3; margin: 0 0 8px; }
  h2 { font-size: 1.25rem; margin: 32px 0 12px; }
  .lead { color: var(--muted); margin: 0 0 20px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 20px; margin-bottom: 16px; }
  label { display: block; font-weight: 600; margin: 14px 0 6px; font-size: 0.95rem; }
  label:first-child { margin-top: 0; }
  input[type='number'],
  input[type='date'],
  select {
    width: 100%; padding: 12px; font-size: 1rem; border: 1px solid var(--line);
    border-radius: 8px; background: #fff;
  }
  input:focus { outline: 2px solid var(--accent); border-color: transparent; }
  .hint { color: var(--muted); font-size: 0.85rem; margin-top: 4px; }
  .result-main { text-align: center; padding: 12px 0 4px; }
  .result-main .label { color: var(--muted); font-size: 0.9rem; }
  .result-main .big { font-size: 2rem; font-weight: 800; color: var(--accent); }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 10px 4px; border-bottom: 1px solid var(--line); text-align: left; font-size: 0.95rem; }
  td:last-child, th:last-child { text-align: right; }
  tr.total td { font-weight: 700; }
  .notice { background: var(--accent-soft); border-radius: 8px; padding: 12px 14px; font-size: 0.88rem; color: #0b3d91; }
  .site-footer { border-top: 1px solid var(--line); padding: 20px 0 40px; color: var(--muted); font-size: 0.85rem; }
  ul.links { list-style: none; padding: 0; margin: 0; }
  ul.links li { margin-bottom: 12px; }
  ul.links a { display: block; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px; text-decoration: none; color: var(--text); }
  ul.links a strong { display: block; color: var(--accent); }
  ul.links a span { color: var(--muted); font-size: 0.9rem; }
  .site-footer .footer-links { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-bottom: 8px; overflow: visible; white-space: normal; }
  .site-footer .footer-links a { margin: 0; color: var(--muted); }
  .prose h2 { margin-top: 36px; }
  .prose h3 { font-size: 1.05rem; margin: 24px 0 8px; }
  .prose p, .prose li { font-size: 1rem; }
  .prose ul, .prose ol { padding-left: 20px; }
  .prose .table-scroll { overflow-x: auto; }
  .prose table th, .prose table td { white-space: nowrap; }
  .meta { color: var(--muted); font-size: 0.88rem; margin: 0 0 20px; }
  .breadcrumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 8px; }
  .breadcrumb a { color: var(--muted); }
  .cta { display: block; text-align: center; background: var(--accent); color: #fff; text-decoration: none; font-weight: 700; border-radius: 10px; padding: 14px; margin: 24px 0; }
  .cta:hover { opacity: 0.92; }
  details { border-bottom: 1px solid var(--line); padding: 12px 0; }
  summary { cursor: pointer; font-weight: 600; }
</style>
