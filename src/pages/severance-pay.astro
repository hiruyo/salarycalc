---
import Base from '../layouts/Base.astro';
import SaveHistory from '../components/SaveHistory.astro';
import { RATES } from '../rates/2026';
import { GUIDES } from '../guides';
const relatedGuides = GUIDES.filter((g) => ['severance-pay-guide'].includes(g.slug));
---

<Base
  title={`${RATES.year}년 퇴직금 계산기 (입사일·퇴사일·최근 3개월 급여)`}
  description="입사일, 마지막 근무일, 퇴직 전 3개월 급여로 퇴직금을 계산합니다. 상여금과 연차수당의 평균임금 반영도 포함."
>
  <h1>퇴직금 계산기</h1>
  <p class="lead">입사일, 마지막 근무일, 최근 3개월 급여만 있으면 예상 퇴직금을 알 수 있어요.</p>

  <form id="calc-form" class="card" onsubmit="return false;">
    <label for="start">입사일</label>
    <input id="start" type="date" value="2022-01-01" />

    <label for="end">마지막 근무일</label>
    <input id="end" type="date" value="2025-12-31" />

    <label for="pay3">퇴직 전 3개월 급여 총액 (원)</label>
    <input id="pay3" type="number" inputmode="numeric" min="0" step="10000" value="9000000" />
    <div class="hint">세전 금액으로, 기본급과 각종 수당을 모두 더한 3개월 합계를 입력하세요.</div>

    <label for="bonus">연간 상여금 총액 (원)</label>
    <input id="bonus" type="number" inputmode="numeric" min="0" step="10000" value="0" />
    <div class="hint">퇴직 전 1년간 받은 상여금 합계예요. 3/12만 반영돼요.</div>

    <label for="leave">연차수당 (원)</label>
    <input id="leave" type="number" inputmode="numeric" min="0" step="10000" value="0" />
    <div class="hint">퇴직 전 1년간 받은 연차수당이에요. 3/12만 반영돼요.</div>
  </form>

  <div class="card" data-history-results>
    <div class="result-main">
      <div class="label">예상 퇴직금 (세전)</div>
      <div class="big" id="out-pay">-</div>
    </div>
    <table>
      <tbody>
        <tr><th>퇴직금 지급 대상</th><td id="out-eligible">-</td></tr>
        <tr><th>재직일수</th><td id="out-tenure">-</td></tr>
        <tr><th>퇴직 전 3개월 일수</th><td id="out-days3">-</td></tr>
        <tr><th>1일 평균임금</th><td id="out-avg">-</td></tr>
      </tbody>
    </table>
  </div>

  <SaveHistory calc="severance-pay" title="퇴직금" />

  <p class="notice">
    퇴직소득세는 반영하지 않은 세전 금액이에요. 평균임금이 통상임금보다 낮은 경우(통상임금 적용)도 반영하지 않으니,
    정확한 금액은 회사 인사팀이나 고용노동부 확인이 필요해요.
  </p>

  <h2>계산 방법</h2>
  <p>
    <strong>퇴직금 = 1일 평균임금 × 30일 × (재직일수 ÷ 365)</strong>예요.
    1일 평균임금은 퇴직 전 3개월 임금 총액에 상여금과 연차수당의 3/12을 더한 뒤, 그 3개월의 총 일수(달력 기준)로 나눕니다.
    계속근로기간이 1년 이상이고 1주 소정근로시간이 15시간 이상이면 지급 대상입니다.
  </p>

  <h2>자주 묻는 질문</h2>
  <details>
    <summary>1년 미만 근무하면 퇴직금이 없나요?</summary>
    <p>계속근로기간이 1년(365일) 미만이면 법정 퇴직금 지급 대상이 아니에요. 회사 규정에 따라 별도로 지급하는 경우는 있어요.</p>
  </details>
  <details>
    <summary>3개월 급여에는 무엇을 넣나요?</summary>
    <p>세전 기본급, 연장·야간 수당 등 정기적으로 받은 임금을 모두 합산해요. 실비 변상 성격의 비용은 제외돼요.</p>
  </details>


  <h2>관련 가이드</h2>
  <ul class="links">
    {relatedGuides.map((g) => (
      <li>
        <a href={`/guide/${g.slug}`}>
          <strong>{g.title}</strong>
          <span>{g.description}</span>
        </a>
      </li>
    ))}
  </ul>

  <script>
    import { calcSeverance } from '../lib/severance';

    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
    const num = (id: string) => Number(val(id)) || 0;
    const won = (n: number) => `${n.toLocaleString('ko-KR')}원`;
    const set = (id: string, text: string) => {
      document.getElementById(id)!.textContent = text;
    };

    function render() {
      const r = calcSeverance({
        startDate: val('start'),
        endDate: val('end'),
        last3MonthsPay: num('pay3'),
        annualBonus: num('bonus'),
        annualLeavePay: num('leave'),
      });
      if (!r.valid) {
        set('out-pay', '-');
        set('out-eligible', '날짜를 확인해 주세요');
        set('out-tenure', '-');
        set('out-days3', '-');
        set('out-avg', '-');
        return;
      }
      set('out-pay', r.eligible ? won(r.severancePay) : '0원');
      set('out-eligible', r.eligible ? '해당 (1년 이상 근무)' : '해당 없음 (1년 미만)');
      set('out-tenure', `${r.tenureDays.toLocaleString('ko-KR')}일`);
      set('out-days3', `${r.last3MonthsDays}일`);
      set('out-avg', won(r.averageDailyWage));
    }

    document.getElementById('calc-form')!.addEventListener('input', render);
    render();
  </script>
</Base>
