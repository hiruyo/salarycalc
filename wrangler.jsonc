// Cloudflare Workers 정적 배포 설정
// - 없는 주소로 들어오면 dist/404.html을 404 상태로 보여줍니다.
// - /salary 같은 주소는 dist/salary.html로 연결됩니다.
{
  "name": "salarycalc",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
